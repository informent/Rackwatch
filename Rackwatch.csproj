<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.1.0</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <DefaultItemExcludes>$(DefaultItemExcludes);test-output\**;tests\**</DefaultItemExcludes>
  <Product>Rackwatch</Product><Title>Rackwatch</Title><Company>informent</Company></PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs;MainWindow.xaml.cs;ServerAudit.cs;AuditReport.cs;AppSettings.cs" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
  </ItemGroup>
</Project>
